# ═══════════════════════════════════════════════════════════════════════════════
# CareWell Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# HOW TO USE:
#   Local dev  → copy this file to .env and fill in your values
#   Vercel     → add each variable in: Vercel Dashboard → Project → Settings → Environment Variables
#
# NEVER commit the .env file to git (it's already in .gitignore)
# ═══════════════════════════════════════════════════════════════════════════════

# ── MongoDB ────────────────────────────────────────────────────────────────────
# ⚠️  MUST be a MongoDB Atlas URI for production — localhost will NOT work on Vercel
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/Hospital-appointment-system?retryWrites=true&w=majority

# ── JWT Secret ─────────────────────────────────────────────────────────────────
# Use a long, random string — minimum 32 characters recommended.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
TOKEN_KEY=replace_with_a_very_long_random_secret_string_at_least_32_chars

# ── Admin Access Code ──────────────────────────────────────────────────────────
# Required when signing up with role="admin". Keep this secret.
ACCESS_CODE=replace_with_your_admin_access_code

# ── Frontend URL (CORS) ────────────────────────────────────────────────────────
# Your deployed Vercel frontend URL — used to allow cross-origin requests.
# Example: https://carewell-frontend.vercel.app
# ⚠️  No trailing slash
FRONTEND_URL=https://your-frontend-name.vercel.app

# ── Local dev only ─────────────────────────────────────────────────────────────
PORT=5000
